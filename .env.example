# Password for the host/admin dashboard login.
ADMIN_PASSWORD=change-me-before-hosting

# Secret used to sign the admin session cookie. Any long random string works.
SESSION_SECRET=change-me-too-any-long-random-string

# --- Production database (Turso) ---
# Leave both blank for local dev — the app falls back to a local SQLite file
# (mystery.db, or DATABASE_PATH if set). Fill these in when deploying, so the
# host on Render (or wherever) points at your Turso database instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
